# Browser-safe values for Lovable / Vite.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_public_key
# Optional compatibility name used by some Supabase/Lovable templates.
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_public_key

# Server-side import only. Never expose this in Lovable or browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_for_local_import_only
